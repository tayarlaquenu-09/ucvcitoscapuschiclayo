# Clave de la API de Anthropic (obligatoria para el análisis de IA).
# Se usa solo en el servidor. Configúrala en Vercel: Settings > Environment Variables.
ANTHROPIC_API_KEY=

# Modelo a usar (opcional). Por defecto: claude-haiku-5-5
ANTHROPIC_MODEL=claude-haiku-5-5

# Transcripción de audio con OpenAI Whisper (opcional).
# Si no se define, las notas de voz se guardan pero no se transcriben.
OPENAI_API_KEY=
